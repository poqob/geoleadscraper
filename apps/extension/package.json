{
  "name": "mapscan_extension",
  "version": "1.2.0",
  "description": "",
  "private": true,
  "scripts": {
    "clean": "rimraf dist && turbo clean",
    "build:local": "dotenv -e .env -- turbo build --force",
    "build:production": "dotenv -e .env.production -- turbo build --force",
    "start:dev": "turbo ready && dotenv -e .env turbo watch dev --concurrency 20",
    "start:production": "turbo ready && dotenv -e .env.production turbo watch dev --concurrency 20",
    "dev-server": "pnpm -F hmr ready && pnpm -F hmr dev",
    "test": "turbo test",
    "type-check": "turbo type-check",
    "lint": "turbo lint --continue -- --fix --cache --cache-location node_modules/.cache/.eslintcache",
    "lint:fix": "turbo lint:fix --continue -- --fix --cache --cache-location node_modules/.cache/.eslintcache",
    "prettier": "turbo prettier --continue -- --cache --cache-location node_modules/.cache/.prettiercache",
    "prepare": "husky install"
  },
  "type": "module",
  "dependencies": {
    "jsdom": "^25.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@rollup/plugin-sucrase": "^5.0.2",
    "@sindresorhus/tsconfig": "^7.0.0",
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitejs/plugin-react-swc": "^4.0.0",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^8.0.0",
    "eslint": "8.57.0",
    "eslint-config-airbnb-typescript": "17.1.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-import": "2.29.1",
    "eslint-plugin-jsx-a11y": "6.8.0",
    "eslint-plugin-prettier": "5.1.3",
    "eslint-plugin-react": "7.33.2",
    "eslint-plugin-react-hooks": "4.6.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "tailwind-merge": "^2.5.5",
    "tailwindcss": "^3.4.16",
    "tslib": "^2.8.1",
    "turbo": "^2.9.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
