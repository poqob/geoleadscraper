# server
HOST=0.0.0.0
PORT=5050

# CORS: comma-separated origins, or "*" to allow any (default for self-hosting)
ALLOWED_ORIGINS=*

# rate limiting
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=1 minute

# puppeteer
# Path to a system Chromium (set in Docker). Leave empty to use the bundled one.
PUPPETEER_EXECUTABLE_PATH=

# scraping tuning (optional)
# EXTRACT_TIMEOUT=15000
# EXTRACT_CONCURRENCY=5
# Default region (ISO-3166 alpha-2) for parsing national phone numbers, e.g. US, DE, RU
# EXTRACT_DEFAULT_COUNTRY=
